# =====================================================================
# Lakshya AI & EkalSahayak Environment Configuration
# =====================================================================

# Environment Mode: 'dev' or 'prod'
ENV=dev

# MongoDB Connection String:
# Local: mongodb://localhost:27017/ekalsahayak_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ekalsahayak_db
MONGODB_URI=mongodb://localhost:27017/ekalsahayak_db
MONGODB_DB_NAME=ekalsahayak_db

# JWT Secret Key for Authentication
# In production, MUST be at least 32 characters long.
JWT_SECRET_KEY=<generate with: python -c "import secrets;print(secrets.token_urlsafe(48))">
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated, NO '*' in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000

# Seed demo student profile (Lakshya) only in dev
SEED_DEMO=true

# Optional AI Providers (Leave blank for deterministic fallback)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Speech-to-Text Provider: 'null' | 'whisper' | 'bhashini'
STT_PROVIDER=null
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
