# =====================================================================
# Sunita AI & EkalSahayak Environment Configuration
# =====================================================================

# MongoDB Connection String:
# Replace with your MongoDB Atlas connection string (or local instance)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ekalsahayak_db
# Or local: mongodb://localhost:27017/ekalsahayak_db
MONGODB_URI=mongodb://localhost:27017/ekalsahayak_db

# MongoDB Database Name
MONGODB_DB_NAME=ekalsahayak_db

# JWT Secret Key for Authentication
JWT_SECRET_KEY=ekalsahayak-super-secret-key-change-in-production-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Backend Server Port
PORT=8000
