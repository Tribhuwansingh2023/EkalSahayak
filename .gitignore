# =====================================================================
# EkalSahayak (Sunita AI) - Git Ignore Configuration
# =====================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/
*/node_modules/
vendor/
pnpm-lock.yaml.tmp

# Python & Virtual Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
.pytest_cache/
.mypy_cache/

# Audio Cache (Local synthesized speech files)
.audio_cache/
*/.audio_cache/
*.mp3
*.wav

# Build outputs
dist/
*/dist/
build/
*/build/
.output/
out/
coverage/

# Logs and debug traces
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.tmp/
temp/

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo

# Local database instances
*.sqlite
*.sqlite3
*.db
