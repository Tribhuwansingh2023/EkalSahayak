{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/lakshya-ai run dev",
    "frontend": "pnpm --filter @workspace/lakshya-ai run dev",
    "dev:frontend": "pnpm --filter @workspace/lakshya-ai run dev",
    "build": "vite build",
    "build:all": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  }
}
